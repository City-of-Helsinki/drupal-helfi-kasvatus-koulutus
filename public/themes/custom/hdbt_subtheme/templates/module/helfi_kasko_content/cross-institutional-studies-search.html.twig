{% set modes_of_study_url = path('entity.node.canonical', {'node': 23}) %}
{% set component_description %}
  <p>{{ 'Search for study units and courses according to subject, topic or name of the study unit. You can also search studies by national examinations, such as the Valintakoe A (‘Entrance examination A’).'|t({}, {'context': 'Cross institutional studies'}) }}</p>
  <p>{{ 'You can filter the search results by starting time, mode of study and language of instruction.'|t({}, {'context': 'Cross institutional studies'}) }}</p>
  <p>{{ 'Learn more about the modes of study on the <a href=":url">Helsinki Online Upper Secondary School</a> webpage.'|t({':url': modes_of_study_url}, {'context': 'Cross institutional studies'}) }}</p>
{% endset %}

<article>
  <div class="components components--computed components--cross-institutional-studies-search">
    {% embed "@hdbt/misc/component.twig" with
      {
        component_classes: [
          'component--react-search',
          'component--event-list',
          'component--full-width',
        ],
        component_title: 'Search studies'|t({}, {'context': 'Cross institutional studies'}),
        component_description: component_description,
      }
    %}
      {% block component_content %}
        {# Hook React app to this div #}
        {{ attach_library('hdbt/event-list') }}
        <div
          id="helfi-events-search"
          data-paragraph-id="cross-institutional-studies-search"
        >
        </div>
        {# Indicate JS not enabled #}
        <noscript>
          <div class="event-list__javascript-disabled">
            {{ 'You must enable JavaScript in your browser for search to work'|t({}, {'context': 'Cross institutional studies'}) }}
          </div>
        </noscript>
      {% endblock %}
    {% endembed %}

  </div>
</article>
