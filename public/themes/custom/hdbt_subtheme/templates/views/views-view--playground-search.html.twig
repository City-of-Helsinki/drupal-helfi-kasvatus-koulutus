{% embed '@hdbt/component/content-list-with-count.twig' with { modifier_class: ['content-list-with-count--large-volume'] } %}
  {% block count_container%}
    {%- if total_rows -%}
      {{ total_rows }} {% trans with {'context': 'Playground search count'}%}playground or family house{% plural total_rows %}playgrounds or family houses{% endtrans %}
